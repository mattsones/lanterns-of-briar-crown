{
  "name": "liams-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "audit:assets": "node scripts/audit-assets.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "playtest:chapter1": "playwright test tests/chapter1.spec.ts",
    "playtest:smoke": "playwright test tests/smoke.spec.ts",
    "playtest:chapter2": "playwright test tests/chapter2.spec.ts",
    "test:rules": "playwright test tests/rules.spec.ts",
    "verify": "npm run audit:assets -- --limit=10 && npm run build && npm run test:rules && npm run playtest:chapter1 && npm run playtest:chapter2 && npm run playtest:smoke"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "sharp": "^0.35.3",
    "tailwindcss": "latest",
    "typescript": "latest"
  }
}
